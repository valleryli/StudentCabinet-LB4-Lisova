<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:StudentCabinet_LB1.Converters"
             x:Class="StudentCabinet_LB1.MainPage"
             Title="Особистий кабінет студента">

    <ContentPage.Resources>
        <conv:ScoreToColorConverter x:Key="ScoreToColorConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14">

            <Label Text="Особистий кабінет студента" FontSize="22" FontAttributes="Bold" />

            <Entry Text="{Binding FullName, Mode=TwoWay}" Placeholder="ПІБ студента" />
            <Entry Text="{Binding Group, Mode=TwoWay}" Placeholder="Група" />

            <Label Text="Середній бал:" />
            <Slider Minimum="0" Maximum="5" Value="{Binding AverageScore, Mode=TwoWay}" />
            <Label Text="{Binding AverageScore, StringFormat='Поточний бал: {0:F2}'}" />

            <Label Text="{Binding Greeting}"
                   FontAttributes="Bold"
                   TextColor="{Binding AverageScore, Converter={StaticResource ScoreToColorConverter}}" />

            <Button Text="Додати студента"
                    Command="{Binding AddStudentCommand}" />

            <BoxView HeightRequest="1" BackgroundColor="LightGray" Margin="0,10" />

            <Label Text="Список студентів" FontSize="18" FontAttributes="Bold" />

            <CollectionView ItemsSource="{Binding Students}" HeightRequest="280">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="6" ColumnDefinitions="*,Auto,Auto,Auto">
                            <Label Grid.Column="0" Text="{Binding FullName}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding Group}" Margin="10,0" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="{Binding AverageScore, StringFormat='{0:F2}'}" VerticalOptions="Center" />

                            <Button Grid.Column="3"
                                    Text="Детальніше"
                                    Margin="10,0,0,0"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenDetailsCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>