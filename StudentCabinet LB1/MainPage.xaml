<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:StudentCabinet_LB1.Converters"
             x:Class="StudentCabinet_LB1.MainPage">

    <ContentPage.Resources>
        <conv:BoolToColorConverter x:Key="BoolToColorConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="Особистий кабінет студента" FontSize="22" FontAttributes="Bold" />

            <Entry Text="{Binding FullName, Mode=TwoWay}" Placeholder="ПІБ студента" />
            <Entry Text="{Binding Group, Mode=TwoWay}" Placeholder="Група" />

            <Label Text="Середній бал:" />
            <Slider Minimum="0" Maximum="5" Value="{Binding AverageScore, Mode=TwoWay}" />
            <Label Text="{Binding AverageScore, StringFormat='Поточний бал: {0:F2}'}" />

            <Label Text="{Binding Greeting, Mode=OneWay}"
                   FontSize="18"
                   TextColor="{Binding IsHighScore, Converter={StaticResource BoolToColorConverter}}" />

            <Button Text="Додати студента"
                    Command="{Binding AddStudentCommand}" />

            <Label Text="Список студентів:" FontAttributes="Bold" Margin="0,20,0,0" />

            <CollectionView ItemsSource="{Binding Students}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,4" Padding="10">
                            <VerticalStackLayout>
                                <Label Text="{Binding FullName}" FontAttributes="Bold" />
                                <Label Text="{Binding Group}" />
                                <Label Text="{Binding AverageScore, StringFormat='Бал: {0:F2}'}" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>