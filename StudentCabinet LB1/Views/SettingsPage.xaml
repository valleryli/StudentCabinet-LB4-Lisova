<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudentCabinet_LB1.Views.SettingsPage"
             Title="Налаштування">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Налаштування" Style="{StaticResource Heading}" />

            <Border Style="{StaticResource Card}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Темна тема" Style="{StaticResource SubHeading}" />
                        <Label Text="Застосовується до всіх сторінок і зберігається між запусками"
                               Style="{StaticResource Muted}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding IsDarkTheme, Mode=TwoWay}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Сесія, deep link і база даних" Style="{StaticResource SubHeading}" />
                    <Label Text="{Binding SessionInfo}" Style="{StaticResource Muted}" />

                    <Label Text="Формат посилання:" />
                    <Label Text="{Binding DeepLinkHint}" Style="{StaticResource Muted}" />

                    <Label Text="Файл бази даних:" />
                    <Label Text="{Binding DatabasePath}" Style="{StaticResource Muted}" LineBreakMode="CharacterWrap" />

                    <Button Text="Перевірити deep link" Command="{Binding TestDeepLinkCommand}"
                            Style="{StaticResource SecondaryButton}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Журнал життєвого циклу" Style="{StaticResource SubHeading}" />
                    <CollectionView ItemsSource="{Binding LifecycleLog}" HeightRequest="240">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Label Text="{Binding .}" FontSize="12" Padding="0,2" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>