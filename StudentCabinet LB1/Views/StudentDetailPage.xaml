<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudentCabinet_LB1.Views.StudentDetailPage"
             Title="Редагування студента">

	<ScrollView>
		<VerticalStackLayout Padding="20" Spacing="16">

			<Label Text="Редагування студента" Style="{StaticResource Heading}" />

			<Border Style="{StaticResource Card}">
				<VerticalStackLayout Spacing="8">
					<Label Text="ПІБ" Style="{StaticResource Muted}" />
					<Entry Text="{Binding FullName, Mode=TwoWay}" />

					<Label Text="Група" Style="{StaticResource Muted}" />
					<Entry Text="{Binding Group, Mode=TwoWay}" />

					<Label Text="Середній бал" Style="{StaticResource Muted}" />
					<Entry Text="{Binding AverageScore, Mode=TwoWay}" Keyboard="Numeric" />

					<Label Text="Номер документа (шифрується в БД)" Style="{StaticResource Muted}" />
					<Entry Text="{Binding PassportNumber, Mode=TwoWay}" />

					<Label Text="{Binding StoredCiphertext, StringFormat='У БД зберігається: {0}'}"
                           Style="{StaticResource Muted}" LineBreakMode="CharacterWrap" />
				</VerticalStackLayout>
			</Border>

			<Button Text="Зберегти" Command="{Binding SaveCommand}" />
			<Button Text="Назад" Command="{Binding GoBackCommand}" Style="{StaticResource SecondaryButton}" />

		</VerticalStackLayout>
	</ScrollView>
</ContentPage>