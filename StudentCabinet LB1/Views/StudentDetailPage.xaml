<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudentCabinet_LB1.Views.StudentDetailPage"
             Title="Деталі студента">

    <VerticalStackLayout Padding="24" Spacing="14">
        <Label Text="Деталі студента" FontSize="22" FontAttributes="Bold" />

        <Label Text="{Binding FullName, StringFormat='ПІБ: {0}'}" />
        <Label Text="{Binding Group, StringFormat='Група: {0}'}" />

        <Label Text="Середній бал (можна редагувати):" />
        <Entry Text="{Binding AverageScore, Mode=TwoWay}" Keyboard="Numeric" />

        <Button Text="Зберегти" Command="{Binding SaveCommand}" Margin="0,10,0,0" />
        <Button Text="Назад" Command="{Binding GoBackCommand}" BackgroundColor="Gray" />
    </VerticalStackLayout>
</ContentPage>